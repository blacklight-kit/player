{
  "name": "@blacklight/player",
  "version": "1.0.2",
  "license": "PolyForm-Noncommercial-1.0.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/blacklight-kit/player.git"
  },
  "exports": {
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./client.css": "./dist/client.css",
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./streaming": {
      "types": "./dist/streaming.d.ts",
      "import": "./dist/streaming.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build:client": "vite build",
    "build:server": "tsup",
    "build": "pnpm run clean && pnpm run build:client && pnpm run build:server",
    "clean": "rm -rf dist/",
    "prepare": "pnpm run build",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.check.json --noEmit",
    "test:unit": "mocha tests/**/*.ts",
    "test": "pnpm run build && pnpm run test:unit",
    "ci": "pnpm run lint && pnpm run typecheck && pnpm run test",
    "dev": "concurrently \"pnpm run dev:server\" \"pnpm run dev:client\"",
    "dev:client": "vite build --watch",
    "dev:server": "tsup --watch"
  },
  "peerDependencies": {
    "react": "^18.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^25.9.3",
    "@types/react": "^19.2.17",
    "@types/sinon": "^21.0.0",
    "@vitejs/plugin-react": "^5.1.2",
    "chai": "^6.2.1",
    "concurrently": "^10.0.3",
    "eslint": "^9.39.2",
    "mocha": "^11.7.5",
    "react": "^19.2.7",
    "sinon": "^22.0.0",
    "tsup": "^8.5.0",
    "typescript-eslint": "^8.56.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.0",
    "vite-plugin-dts": "^4.5.4"
  },
  "dependencies": {
    "uuid": "^13.0.0"
  },
  "packageManager": "pnpm@10.4.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}